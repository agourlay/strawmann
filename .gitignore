# Build artifacts. These are ~9 GB combined and dominate the tree — `tokei`
# without exclusions reports the project as mostly D and C, which is cargo's
# `.d` dependency files and vendored headers from `zstd-sys`/`aws-lc-sys`.
.zig-cache/
zig-out/
conformance/target/

# Benchmark output. Regenerable by `bench/harness/workloads.py`, and §7.1
# forbids quoting any of it from an ungated host anyway — committing results
# invites exactly the comparison the gate exists to prevent.
#
# Disposable is not the same as unreferenced: a label a document cites, or that
# a committed page under `docs/reports/` was rendered from, is the only thing a
# generated block can be regenerated from. `fullrun.prune` keeps those and
# deletes the rest after `RETAIN_DAYS`; deleting one by hand is how
# `docs/comparison-dbpedia-openai-100K-1536-angular.md` became unregenerable.
bench/results/

# Datasets live in $STRAWMANN_DATA (default ~/.cache/strawmann/datasets), never
# in the tree: SIFT1M is 550 MB and the headline tier is 9 GB.
# `conformance/datasets/datasets.json` is what makes them reproducible.
*.fbin
*.fvecs
*.ivecs
*.parquet
*.hdf5

# Editor/OS noise.
*.swp
.DS_Store

# uv creates this from bench/uv.lock; the lock is tracked, the tree is not
bench/.venv/
# generated by report.py from bench/results/, which is itself ignored. One page
# per run -- (dataset, labels, day, minute), because a day holds more than one
# run of one pair: report-sift1m-strawmann-vs-qdrant-2026-08-27-2140.html.
bench/results/report-*.html
# A published run's page is committed by moving it to `docs/reports/`, which this
# rule does not cover: a rendered page carries its own gate verdict, tier and
# pass count, so it cannot be quoted out of context the way a bare `rows.json`
# can. Cheap, too — the inlined plotly is identical between pages, so git deltas
# all but the first to near zero.
__pycache__/
.venv/

# The §7.3 results sink. Measurements from an ungated host, in a format that
# invites exactly the cross-environment comparison §7.1 forbids; the same
# reasoning as bench/results/.
bench/results.sqlite
bench/results-backup-*/

