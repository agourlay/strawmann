.{
    .name = .strawmann,
    .version = "0.1.0",
    // Globally unique package identifier. Generated once, never changed.
    .fingerprint = 0x25bdd149aa1cd47c, // Changing this has security and trust implications.

    // §9: "Pin an exact Zig toolchain version in build.zig.zon and CI. The
    // language still moves; a benchmark that silently changes compiler is not a
    // benchmark." LLVM's autovectoriser and its AVX-512 cost model both move
    // between releases, and an unpinned compiler turns the ISA matrix into noise.
    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "bench",
        "docs",
    },
}
